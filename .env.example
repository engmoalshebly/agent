# SAIA Insurance Broker Platform - Environment Configuration
# Copy this to .env and fill in your values

# ================================
# API Configuration
# ================================
API_TITLE=SAIA Insurance Broker API
API_VERSION=2.0.0
API_PREFIX=/api/v1
DEBUG=true
PORT=3300

# ================================
# Security
# ================================
API_KEY=your-api-key-here
JWT_SECRET=your-jwt-secret-here

# ================================
# PostgreSQL Database
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saia_insurance
DB_USER=postgres
DB_PASSWORD=your-db-password

# Or use full connection string:
# POSTGRESQL_URL=postgresql://user:pass@host:5432/dbname

# ================================
# MongoDB (Conversations)
# ================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=saia_conversations

# ================================
# LLM - Google Gemini
# ================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3

# ================================
# LLM - OpenAI (Optional)
# ================================
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.0

# ================================
# Session Settings
# ================================
SESSION_TIMEOUT_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=30

# ================================
# Invoice Settings
# ================================
INVOICE_EXPIRY_HOURS=24
VAT_RATE=0.15

# ================================
# Logging
# ================================
LOG_LEVEL=INFO
LOG_FORMAT=json
